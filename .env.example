# Perry, local env. Copy to .env.local, or let `perry setup` write it.
# The dashboard's server, which is also Perry's backend, reads it.

# Guards the dashboard and the backend's API. Any long random string.
DASHBOARD_KEY=generate-a-long-random-string

# Optional: a Telegram bot from @BotFather. Perry polls Telegram with it.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Optional: Gmail, Calendar, Notion and the rest, through Composio.
# COMPOSIO_API_KEY=

# Optional: where Perry keeps its data (default ~/.perry), and its port (7377).
# PERRY_HOME=
# PERRY_PORT=

# Optional: show the real chat browser in the Files / Work / Browser workspace.
# PERRY_BROWSER_VIEW=1
# Optional: connect signed-in Chrome locally, or import selected Firefox sessions.
# Import requires a local dashboard connection; read docs/live-browser.md first.
# PERRY_BROWSER_IMPORT=1
# Optional: Chrome user data directory, for a nonstandard installation.
# PERRY_CHROME_USER_DATA_DIR=
# Optional: registered Firefox profiles directory (for portable Firefox / test fixtures).
# PERRY_FIREFOX_ROOT=

# PostHog US Cloud project 661214. Public ingestion key, safe in browser code.
# These NEXT_PUBLIC values are baked in during `pnpm build`; rebuild after changes.
# Defaults to enabled in production, disabled in development. Set false to opt out.
# NEXT_PUBLIC_POSTHOG_ENABLED=false
# NEXT_PUBLIC_POSTHOG_KEY=phc_qeCkb5s5b6x4T5adoyZWdCKsmwK27dKq3RginMwWAwqn
# Disable installer/setup milestone telemetry too (also usable as a shell env var).
# PERRY_TELEMETRY_DISABLED=1
