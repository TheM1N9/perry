# ---------------------------------------------------------------------------
# Local / Next.js env. Copy to .env.local.
# ---------------------------------------------------------------------------

# Printed by `pnpm exec convex dev` on first run.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Same deployment, .site domain. This is what Telegram posts to.
CONVEX_SITE_URL=https://your-deployment.convex.site

# Used only by scripts/telegram-webhook.mjs to register the webhook.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string


# ---------------------------------------------------------------------------
# Convex deployment env. These are NOT read from this file.
# Set them with `pnpm exec convex env set NAME value`, or in the Convex dashboard.
# ---------------------------------------------------------------------------
#
#   pnpm exec convex env set TELEGRAM_BOT_TOKEN       123456:ABC-DEF...
#   pnpm exec convex env set TELEGRAM_WEBHOOK_SECRET  <same long random string>
#   pnpm exec convex env set TELEGRAM_OWNER_CHAT_ID   <your numeric chat id>
#   pnpm exec convex env set AI_GATEWAY_API_KEY       <vercel ai gateway key>
#
# Optional, only once the sandbox lands:
#
#   pnpm exec convex env set DAYTONA_API_KEY          <daytona key>
#   pnpm exec convex env set COMPOSIO_API_KEY         <composio key>
